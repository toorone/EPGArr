# OPTIONAL alternative to the crontab schedule that setup.php installs.
# Use one or the other, not both.
#
# Replace the four placeholders, then (needs admin rights):
#   sudo cp epg-loader.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now epg-loader
#
#   <PHP_USER>    the user PHP runs as (shown on setup.php under "PHP runs as")
#   <DATA_DIR>    the data folder (shown on setup.php under "Detected paths")
#   <WEB_DIR>     the web folder holding index.html (also shown there)
#   <PROGRAM>     the epg-loader program path (shown there as "Program")

[Unit]
Description=EPG loader (rebuilds the XMLTV guide on a schedule)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=<PHP_USER>
Environment=EPG_LOADER_DIR=<DATA_DIR>
Environment=EPG_OUTPUT_DIR=<WEB_DIR>
ExecStart=<PROGRAM> watch
UMask=0002
Restart=on-failure
RestartSec=60
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
